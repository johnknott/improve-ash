layout {
    pane size=1 borderless=true {
        plugin location="tab-bar"
    }
    pane split_direction="Vertical" {
        pane command="bash" {
            args "-lc" "mise run phx:server"
        }
        pane split_direction="Horizontal" {
            pane command="bash" {
                args "-lc" "mise run frontend:dev"
            }
            pane split_direction="Vertical" {
                pane command="bash" {
                    // No --restart: killing a mid-run BEAM races and leaves
                    // orphaned nodes holding DB pools; queue the rerun instead.
                    // Debounce so a burst of saves triggers one run, not many.
                    args "-lc" "watchexec -w lib -w test -w config -e ex,exs --debounce 3000 -- mix test --stale"
                }
                pane command="bash" {
                    args "-lc" "iex -S mix"
                }
            }
        }
    }
    pane size=1 borderless=true {
        plugin location="status-bar"
    }
}
